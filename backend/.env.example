# ═══════════════════════════════════════════════════
# PLACEONIX BACKEND - ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════
# Copy this to .env and edit values for your environment.

# ─── Server ───
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ─── Database ───
MONGO_URI=mongodb://localhost:27017/placeonix-hub
# For Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/placeonix-hub
# No local MongoDB install and no Atlas cluster handy? `npm run local-mongo`
# (src/scripts/local-mongo.js) runs a real mongod against a persistent
# on-disk data dir (backend/data/mongo-db, gitignored) — data survives
# restarts as long as you keep reusing that script/folder. Then:
# MONGO_URI=mongodb://127.0.0.1:27417/placeonix-hub

# ─── JWT (Authentication) ───
# MUST be 32+ characters and different from each other
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-chars
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-too-32-chars
JWT_REFRESH_EXPIRE=30d
JWT_COOKIE_EXPIRE=7

# ─── Email (for notifications, password reset) ───
# Leave SMTP_HOST empty to skip emails (they will be logged instead — see
# services/emailService.js's fallback). Plain SMTP, so any provider works —
# switching later (e.g. Gmail -> Zoho) is only ever these four values, no
# code change:
#   Gmail:  smtp.gmail.com : 587  — SMTP_PASS must be a 16-char Google
#           "App Password" (myaccount.google.com/apppasswords, requires
#           2-Step Verification on), NOT your normal account password.
#   Zoho:   smtp.zoho.com  : 587 (or 465 for SSL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admissions@placeonix.in
SMTP_PASS=your-16-char-gmail-app-password
EMAIL_FROM=Placeonix <admissions@placeonix.in>
CONTACT_PHONE=+91 98765 43210

# ─── WhatsApp (optional — Meta WhatsApp Cloud API) ───
# Leave WHATSAPP_ACCESS_TOKEN empty to skip WhatsApp sends (logged instead,
# same fallback pattern as email — see services/whatsappService.js). Get
# both from developers.facebook.com > your app > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ─── CORS ───
# Frontend URLs allowed to call this API. Comma-separated. Use * for any (dev only).
# Must be an exact origin (not *) for the httpOnly auth cookie to work cross-origin —
# the Next.js frontend's local dev server (frontend/) runs on :3000.
CLIENT_URL=http://localhost:3000

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
# Per-IP cap on login/register/forgot-password attempts per 15-minute window.
# Kept separate (and lower) from the general API limit above — this is the
# brute-force backstop, alongside the per-account lockout in User.js.
AUTH_RATE_LIMIT_MAX=30

# ─── File Upload ───
MAX_FILE_UPLOAD=10
FILE_UPLOAD_PATH=./uploads
# On serverless (Vercel/Lambda) local disk storage does NOT persist between
# invocations. Set these three to switch uploads to S3 — required for any
# production deploy on a serverless platform:
# S3_BUCKET=placeonix-hub-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1

# ─── Background Jobs ───
# Set to 'true' to disable all cron jobs (useful during testing)
DISABLE_CRON=false

# ─── Code Execution (coding challenges) ───
# Untrusted student code is NEVER run on this server — it's forwarded to an
# external sandboxed executor. Default is the free, no-key-required public
# Piston instance; swap for a self-hosted Piston or paid provider by changing
# the URL only (see services/codeExecutionService.js).
CODE_EXEC_API_URL=https://emkc.org/api/v2/piston
CODE_EXEC_RUN_TIMEOUT_MS=8000
CODE_EXEC_RATE_LIMIT_MAX=15
