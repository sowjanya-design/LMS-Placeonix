{
  "name": "placeonix-backend-v2",
  "version": 2,
  "env": {
    "MONGO_URI": "SET_IN_VERCEL_DASHBOARD_NOT_HERE",
    "JWT_SECRET": "SET_IN_VERCEL_DASHBOARD_NOT_HERE",
    "JWT_REFRESH_SECRET": "SET_IN_VERCEL_DASHBOARD_NOT_HERE",
    "JWT_COOKIE_EXPIRE": "7",
    "DISABLE_CRON": "true",
    "NODE_ENV": "production",
    "CLIENT_URL": "https://placeonix-frontend-v2.vercel.app,https://frontend-three-jade-53.vercel.app,https://frontend-qw52b5sa0-sowjanya-designs-projects.vercel.app,https://lms-placeonix-me1m28vps-sowjanya-designs-projects.vercel.app,https://lms-placeonix.vercel.app,https://lms-placeonix-sowjanya-designs-projects.vercel.app"
  },
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/health", "dest": "api/index.js" },
    { "src": "/(.*)", "dest": "api/index.js" }
  ]
