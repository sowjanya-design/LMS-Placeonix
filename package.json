{
  "name": "placeonix-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Placeonix Hub — convenience scripts that delegate to the backend + frontend",
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "start": "npm --prefix backend start",
    "seed": "npm --prefix backend run seed",
    "install:backend": "npm --prefix backend install",
    "portal": "npm --prefix frontend run dev",
    "install:frontend": "npm --prefix frontend install"
  }
}
